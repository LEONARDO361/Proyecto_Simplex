	<script>
		// Función para abrir y cerrar los modales de cada producto
		function setupModal(openButtonId, modalId, closeButtonId) {
			document.getElementById(openButtonId).onclick = function () {
				document.getElementById(modalId).style.display = 'block';
			};
			document.getElementById(closeButtonId).onclick = function () {
				document.getElementById(modalId).style.display = 'none';
			};
			window.onclick = function (event) {
				if (event.target == document.getElementById(modalId)) {
					document.getElementById(modalId).style.display = 'none';
				}
			};
		}

		// Configurar los modales
		setupModal('openModalButton1', 'productModal1', 'closeModal1');
		setupModal('openModalButton2', 'productModal2', 'closeModal2');
